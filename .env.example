# Copy this file to .env before running docker compose.
# Do not commit real API keys.

BACKEND_PORT=8000
FRONTEND_PORT=3000
REACT_APP_API_BASE_URL=http://localhost:8000

# Model paths inside the backend container. Keep these defaults if you mount ./models.
MODEL_CHECKPOINT_PATH=/app/models/fairseq/baseline_6_3_dp03_wd/ckpts/checkpoint_best.pt
VOCAB_MODEL_PATH=/app/models/vocab/cvpr23.train.how2sign.unigram7000_lowercased.model

# Feedback storage. Use "auto" to use Supabase when configured, otherwise local ./data fallback.
FEEDBACK_STORAGE_MODE=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FEEDBACK_TABLE=feedback_samples
SUPABASE_STORAGE_BUCKET=feedback-features

# Multilingual agent. Set to false if you only need Sign -> English and feedback capture.
MULTILINGUAL_AGENT_ENABLED=false
MULTILINGUAL_TARGET_LANGUAGES=en,de,ja,vi
MULTILINGUAL_BACK_TRANSLATION_ENABLED=false
MULTILINGUAL_QUALITY_THRESHOLD=0.72

# Optional translation providers.
GEMINI_API_MODE=developer
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_LOCATION=us-central1
GEMINI_MODEL_ID=gemini-2.5-flash-lite
GEMINI_ACCESS_TOKEN=

OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

GOOGLE_TRANSLATE_API_KEY=
