# TV1 — trích xuất đặc trưng (multipart: field mặc định "file")
API_FEATURE_URL=https://tv1.example.com/features

# TV2 — dịch (JSON body = JSON TV1 trả về)
API_TRANSLATE_URL=https://tv2.example.com/translate

# Giới hạn upload (gateway)
MAX_UPLOAD_MB=50

# Timeout mỗi lần gọi TV1/TV2 (giây)
TIMEOUT_SEC=120

# Tuỳ chọn: đổi tên field file nếu TV1 yêu cầu (vd: video, upload)
# FEATURE_FILE_FIELD=file
# FEATURE_UPLOAD_NAME=clip.mp4
