# TV1 — trích xuất đặc trưng (multipart: field mặc định "file")
API_FEATURE_URL=https://tv1.example.com/features

# TV2 — dịch (JSON body = JSON TV1 trả về)
API_TRANSLATE_URL=https://tv2.example.com/translate

# Giới hạn upload (gateway)
MAX_UPLOAD_MB=50

# Timeout mỗi lần gọi TV1/TV2 (giây)
TIMEOUT_SEC=120

# Multilingual agent
MULTILINGUAL_AGENT_ENABLED=true
MULTILINGUAL_TARGET_LANGUAGES=en,de,ja,vi
MULTILINGUAL_QUALITY_THRESHOLD=0.72
MULTILINGUAL_BACK_TRANSLATION_ENABLED=true
MULTILINGUAL_QUALITY_THRESHOLD=0.5

# Gemini / Vertex AI
GEMINI_API_KEY=
GEMINI_PROJECT_ID=fact-checking-494003
GEMINI_LOCATION=us-central1
GEMINI_MODEL_ID=gemini-2.5-flash-lite
GEMINI_API_MODE=vertex

# Optional extra providers
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
GOOGLE_TRANSLATE_API_KEY=

# Tuỳ chọn: đổi tên field file nếu TV1 yêu cầu (vd: video, upload)
# FEATURE_FILE_FIELD=file
# FEATURE_UPLOAD_NAME=clip.mp4
